{
  "name": "@owlvigil/sdk",
  "version": "0.2.1",
  "description": "Node.js SDK for OwlVigil Gateway and Management APIs",
  "keywords": ["owlvigil", "ai", "gateway", "openai", "sdk"],
  "author": "OwlVigil",
  "license": "MIT",
  "homepage": "https://github.com/Syrovex/owlvigil_sdk_nodejs#readme",
  "bugs": { "url": "https://github.com/Syrovex/owlvigil_sdk_nodejs/issues" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "!dist/**/*.test.js", "!dist/**/*.test.d.ts", "docs/API.md", "docs/README.md", "docs/DEVELOPER_GUIDE.zh-CN.md", "docs/en-US", "docs/zh-CN", "README.md", "CHANGELOG.md", "SECURITY.md", "LICENSE"],
  "sideEffects": false,
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:openapi": "node scripts/check-management-operations.mjs",
    "generate:management": "node scripts/generate-management-operations.mjs",
    "generate:management-types": "node scripts/generate-management-types.mjs",
    "generate:management-methods": "node scripts/generate-management-methods.mjs",
    "generate:management-all": "npm run generate:management && npm run generate:management-types && npm run generate:management-methods",
    "test": "npm run build && node --test dist/*.test.js",
    "check:examples": "node --check examples/quickstart.mjs && node --check examples/management-openapi.mjs",
    "check": "npm test && npm run check:openapi && npm run check:examples && npm pack --dry-run",
    "prepack": "npm run build"
  },
  "engines": { "node": ">=20" },
  "packageManager": "npm@11.5.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syrovex/owlvigil_sdk_nodejs.git"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
